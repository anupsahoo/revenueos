# Copy to .env.local for local dev, or set in the Vercel dashboard.
# Without a key, the app runs fully — POC drafting falls back to a deterministic
# sample plan. With a key, the agent drafts with Claude.

# Anthropic API key — enables real Claude drafting.
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5).
# For a faster / cheaper demo: claude-sonnet-5
LLM_MODEL=
