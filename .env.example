# Copy to .env.local for local dev, or set in the Vercel dashboard.
# Without a key, the app runs fully — POC drafting falls back to a deterministic
# sample plan. With a key, the agent drafts with the AI model.

# AI API key — enables real drafting.
ANTHROPIC_API_KEY=

# The AI model id to use (required to enable drafting).
# e.g. a fast, low-cost model for demos
LLM_MODEL=
